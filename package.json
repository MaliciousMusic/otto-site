{
  "name": "otto-site",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "preview": "SITE_URL=https://maliciousmusic.github.io/otto-site node tools/build.mjs --preview",
    "release": "node tools/build.mjs --release",
    "test": "node tests/replay.mjs && node tools/build.mjs --quiet && node tests/site.mjs && node tests/security.mjs",
    "deploy": "node tools/deploy.mjs",
    "rollback": "node tools/deploy.mjs --rollback",
    "check-live": "node tools/check-live.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
